{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@jia/web", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace", "@jia/web", "--", "-p", "3200"],
      "port": 3200
    },
    {
      "name": "attach-3000",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
