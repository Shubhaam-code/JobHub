{
  "name": "@jia/api",
  "version": "0.1.0",
  "private": true,
  "description": "Job & Internship Aggregator API (Express + MongoDB). Phase 0 foundation.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "telegram:login": "tsx src/scripts/telegram-login.ts",
    "telegram:channel-check": "tsx src/scripts/telegram-channel-check.ts",
    "telegram:listen": "tsx src/scripts/telegram-listener.ts",
    "telegram:backfill": "tsx src/scripts/telegram-backfill.ts",
    "queue:status": "tsx src/scripts/queue-status.ts",
    "jobs:cleanup": "tsx src/scripts/jobs-cleanup.ts",
    "user:create": "tsx src/scripts/create-user.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3",
    "telegram": "^2.26.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
