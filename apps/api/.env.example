# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express server listens on. Leave this unset on a host that injects its
# own PORT (Render, Railway, Fly) — the injected value is used automatically.
PORT=4000

# MongoDB connection string (mongodb:// or mongodb+srv://).
# REQUIRED IN PRODUCTION: the API refuses to boot with NODE_ENV=production and no
# MONGODB_URI, rather than silently falling back to this localhost default and
# connecting to nothing.
MONGODB_URI=mongodb://127.0.0.1:27017/job_aggregator

# Comma-separated list of allowed browser origins for CORS, used by both the REST
# routes and Socket.IO. Origins only — no path, no trailing slash.
# REQUIRED IN PRODUCTION: the localhost default would reject the deployed
# frontend, so the API refuses to boot without it.
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGINS=http://localhost:3000

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info

# --- Telegram (MTProto via GramJS) -------------------------------------------
# Create an application at https://my.telegram.org -> API development tools,
# then copy the two values below. Leave them blank if you are not working on
# the Telegram integration; the API boots fine without them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated by: npm run telegram:login --workspace @jia/api
# This string grants full access to the Telegram account. Keep it in .env only
# (never commit it, never share it, never expose it through an API response).
TELEGRAM_SESSION=

# Comma-separated list of public Telegram channel usernames to listen to.
# The leading @, extra whitespace and duplicates are all handled. Adding a
# channel here needs no code change: classification and extraction are generic.
# Example: TELEGRAM_CHANNELS=@offcampusjobs4u,@getjobss,@freshershunt
TELEGRAM_CHANNELS=offcampusjobs4u,datasciencej,HireMeFresh,careerwithasr,internshiptojobs,jobs_SQL,getjobss,Fresherjobsadda,freshercareersdotin,fresher_offcampus_drives,oflatestblog,placementdriveofficial,fresheroffcampus,goyalarsh,placementkit,job4fresherss,freshershunt

# --- LLM (Google Gemini via @google/genai) -----------------------------------
# Create a key at https://aistudio.google.com/apikey. Every ingested post is
# classified (job / not a job) and its fields extracted by the model, so without
# a key the API still boots but stores nothing. Treat the key like a password.
GEMINI_API_KEY=

# Model used for classification. A fast/cheap model is the right choice here.
GEMINI_MODEL=gemini-3.7-flash

# --- Resume parsing LLM (Groq) -----------------------------------------------
# Create a key at https://console.groq.com/keys. Resume uploads are parsed by
# Groq only — there is no second provider and no fallback, so without a key the
# upload returns the "could not analyse your resume" state and the user sets
# their preferences by hand. Backend-only: this key is never sent to the browser.
GROQ_API_KEY=

# Must be a Groq model that supports strict JSON-schema structured outputs
# (openai/gpt-oss-20b, openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-20b

# Hard ceiling per LLM attempt (ms), so ingestion never waits indefinitely.
LLM_TIMEOUT_MS=20000

# --- LLM throttling ----------------------------------------------------------
# The worker throttles itself BEFORE calling the provider, so the common case is
# never hitting a 429 at all. Match these to the quota of your Gemini key: the
# free tier is 15 RPM, so 10 leaves headroom. Only classification passes through
# here — resume parsing runs on Groq with its own quota.

# Requests per rolling minute, across the whole process.
LLM_MAX_REQUESTS_PER_MINUTE=10

# How many LLM calls may be in flight at once. 1 = strictly serial.
LLM_CONCURRENCY=1

# --- Ingest queue worker -----------------------------------------------------
# Telegram ingestion writes into the durable `ingest_queue` collection; this
# worker drains it. The two halves are independent, so the listener keeps
# ingesting while the LLM is slow, rate limited or down.

# Set to false to keep ingesting into the queue without classifying anything —
# useful when backfilling a lot of history before spending any quota.
QUEUE_WORKER_ENABLED=true

# How often the worker looks for claimable messages once the queue is empty (ms).
QUEUE_POLL_INTERVAL_MS=2000

# Attempts before a message is parked as `failed` (dead-letter). It is never
# deleted: a failed row keeps its raw text for inspection and manual replay.
QUEUE_MAX_ATTEMPTS=6

# First backoff step (ms). Each further attempt doubles it: 5s, 10s, 20s, 40s…
# A provider-supplied Retry-After always wins over this curve.
QUEUE_RETRY_BASE_MS=5000

# Ceiling on backoff (ms), so a long outage never schedules a retry days out.
QUEUE_RETRY_MAX_MS=600000

# A `processing` claim older than this (ms) is treated as abandoned by a killed
# worker and returned to `pending` on the next boot. This is what makes an
# in-flight message survive a crash or a kill -9.
QUEUE_STALE_CLAIM_MS=300000

# --- Apply-link integrity -----------------------------------------------------
# The link behind Apply Now must be the employer's own page or their ATS form,
# never a competitor's article about the job. A few channels post such an article
# (job4freshers.co.in/microsoft-off-campus-recruitment/) instead of the company's
# link; for those pages only, the worker fetches the article once and reads the
# real apply link out of it. Every other URL is judged without a request being
# made, and a direct company/ATS link is stored exactly as posted.
#
# When the real link cannot be established the apply field is left EMPTY and the
# article is kept as provenance for review. That is deliberate: a missing Apply
# button is a gap, a wrong one is a lie.
#
# All four lists below are additive. The seed lists in src/apply-url/domains.ts
# always apply, so a mangled value here can only fail to add a domain — it can
# never silently unblock one.

# Extra job-aggregator hostnames, comma-separated. A URL on one of these can
# never be stored as an apply link. Derive additions from the host table printed
# by `npm run jobs:fix-apply-urls -- --report` rather than by guessing.
# Example: APPLY_URL_AGGREGATOR_DOMAINS=freshersnow.com,jobsdrive.example
APPLY_URL_AGGREGATOR_DOMAINS=

# Extra ATS / recruiting-platform hostnames, comma-separated. Being listed here
# makes a URL *acceptable*, so add only platforms that host an employer's own
# application form.
APPLY_URL_TRUSTED_ATS_DOMAINS=

# Extra link-shortener / redirect-wrapper hostnames, comma-separated. These are
# followed to their destination, and the destination is what gets judged.
APPLY_URL_WRAPPER_DOMAINS=

# Our own frontend hostnames, comma-separated. An apply link pointing back at us
# is a loop rather than an application, so it is rejected like an aggregator.
APPLY_URL_OWN_DOMAINS=

# Hard ceiling on one request when following a shortener or reading an article
# (ms). On a timeout the apply field is left empty and the row goes to review.
APPLY_URL_RESOLVE_TIMEOUT_MS=8000

# Set to false to accept an aggregator apply URL on the write path again. An
# emergency escape hatch, not a tuning knob: with it off, ingestion stores
# whatever it extracted and only the render guard in the jobs route stands
# between a bad row and a live bad link.
APPLY_URL_ENFORCE=true

# Extra aggregator hostnames under the older name. Still read, and merged into
# APPLY_URL_AGGREGATOR_DOMAINS above; prefer that name for new entries.
# Example: INTERMEDIARY_JOB_SITES=freshersnow.com,jobsdrive.example
INTERMEDIARY_JOB_SITES=

# --- Company logos ------------------------------------------------------------
# A job's company name is turned into a logo URL once, verified, and stored on the
# job, so every card can show the company's own mark. Entirely optional: a name
# that yields no verified logo leaves the field null and the card draws the same
# monogram it always has. Nothing about job fetching, apply links or dedup depends
# on this — a provider outage only means monograms.

# Set to false to stop looking logos up. Logos already stored still display.
COMPANY_LOGO_ENABLED=true

# Logo/icon provider, with {domain} where the company's hostname goes. The
# default needs no API key and answers a plain 404 for a domain it has no icon
# for, which is the signal the resolver verifies against.
COMPANY_LOGO_PROVIDER_URL=https://icons.duckduckgo.com/ip3/{domain}.ico

# Hard ceiling on one provider request (ms). On a timeout the job is stored with
# no logo rather than waiting.
COMPANY_LOGO_TIMEOUT_MS=5000

# Companies held in the in-process logo cache, hits and misses alike. One lookup
# per company rather than per job; bounded so the map cannot grow forever.
COMPANY_LOGO_CACHE_MAX=2000

# --- Auth (admin dashboard) ---------------------------------------------------
# Accounts exist only to gate /admin. AUTH_SECRET signs the bearer tokens issued
# by POST /api/auth/login, so changing it invalidates every outstanding token —
# which is the intended way to revoke them all.
#
# REQUIRED IN PRODUCTION: the API refuses to boot without it, because a guessable
# signing key makes admin tokens forgeable. Minimum 16 characters; generate one
# with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Lifetime of an issued token, in hours. Short by default — it only unlocks /admin.
AUTH_TOKEN_TTL_HOURS=12

# Optional first-admin bootstrap, applied idempotently at every startup. It only
# ever creates a missing account: an existing user's password is never rewritten,
# so leaving these set does not undo a password change. An existing non-admin
# account with this email is promoted to ADMIN.
# `npm run user:create --workspace @jia/api` is the alternative for a one-off.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Resume upload / recommendations -----------------------------------------
# Largest resume PDF accepted by POST /api/v1/profile/resume, in bytes. The PDF
# is parsed in memory and discarded — nothing is written to disk or object
# storage, so no persistent volume is needed in a deployment.
RESUME_MAX_BYTES=5000000

# Lowest match score (0-100) a job needs to be recommended at all. Raise it for
# stricter recommendations, lower it to see more.
RECOMMENDATION_MIN_SCORE=50
