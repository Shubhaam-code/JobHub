# Base URL of the aggregator API. Inlined into the browser bundle at build time.
#
# REQUIRED IN PRODUCTION: `next build` fails without it rather than baking this
# localhost value into every visitor's bundle, where it resolves to nothing and is
# blocked as mixed content by the HTTPS page. Set it to the deployed API origin —
# scheme and host only, no trailing slash and no /api suffix (the client adds the
# paths itself). Example: NEXT_PUBLIC_API_URL=https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL for the Socket.IO realtime connection. Only needed when Socket.IO is
# served from a different origin than the API; leave it unset otherwise and
# NEXT_PUBLIC_API_URL is used.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Clerk (user authentication) ----------------------------------------------
# Normal user accounts only. Admin sign-in is a separate system that lives in the
# API (ADMIN_EMAIL / ADMIN_PASSWORD in apps/api/.env) and needs none of these.
#
# Keys come from the Clerk dashboard: https://dashboard.clerk.com → API keys.
# Without them, `npm run dev:web` still serves the feed and the admin dashboard,
# but `npm run build:web` fails on purpose rather than produce an app whose
# authentication gate does nothing.

# Public by design: identifies the Clerk instance and is inlined into the browser
# bundle. Safe to commit to a deployment's environment, not to git.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# SERVER ONLY. Never rename this to NEXT_PUBLIC_* and never import it into a
# component — that would inline it into the browser bundle and publish it. Read
# only by src/proxy.ts, which runs on the server.
CLERK_SECRET_KEY=

# Our own sign-in and sign-up pages, so Clerk links to them instead of to the
# hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after signing in or up when nothing else asked for a destination.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/



